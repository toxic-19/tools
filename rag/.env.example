# ============================================================
# .env 配置示例文件
# ============================================================
# 将此文件复制为 .env 并填入实际值。
# 所有配置项均可通过环境变量覆盖 config.py 中的默认值。
#
# 使用 uv 加载 .env:
#   uv run --env-file .env run_server.py
#   uv run --env-file .env run_cli.py
# ============================================================

# ============================================================
# Embedding 模型配置
# ============================================================
# 方式一：本地模型（需安装 sentence-transformers）
#   uv sync --extra local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# 方式二：API 模式（取消注释并填入）
# EMBEDDING_API_KEY=your-api-key-here
# EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================
# LLM 大模型配置
# ============================================================
LLM_MODEL_NAME=qwen/qwen-2.5-72b-instruct
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ============================================================
# Rerank 配置
# ============================================================
# cross_encoder: 本地 bge-reranker-large（需 uv sync --extra local）
# llm: 使用上方 LLM 打分
# none: 不重排
RERANK_MODE=cross_encoder
RERANK_MODEL_NAME=BAAI/bge-reranker-large

# ============================================================
# Milvus 连接
# ============================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_demo

# ============================================================
# 检索与分块参数
# ============================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SEARCH_TOP_K=20
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.0

# ============================================================
# RAG MCP Server (阶段 2)
# ============================================================
# RAG 工具通过 MCP 协议对外暴露的 transport。
# 启动方式:uv run run_mcp_sse.py
# 端口与 Agent Hub / RAG FastAPI 错开,避免冲突。
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765

# ============================================================
# AI 智能体能力支撑平台 / Agent Hub (阶段 3)
# ============================================================
# 启动方式:uv run run_agent.py
AGENT_HOST=0.0.0.0
AGENT_PORT=8100

# Agent 循环最大步数(超过则强制结束)
AGENT_MAX_STEPS=8

# Agent 感知阶段用于 RAG 召回的 top_k
AGENT_RAG_TOPK=3

# 智能体平台调用的 MCP Server 地址(连 RAG MCP Server)
AGENT_MCP_SERVER_URL=http://localhost:8765/sse

# 是否启用 Mock 微服务工具(ehr_patient_query / clinical_guideline_lookup)
AGENT_ENABLE_MOCK_MICROSERVICE=true

# ============================================================
# 安全沙箱配置(阶段 3)
# ============================================================
# 子进程 wall-clock 超时(毫秒),超时后 SIGKILL
SANDBOX_TIMEOUT_MS=10000

# 沙箱内 Python 进程允许的最大输出字节数(超出截断)
SANDBOX_MAX_OUTPUT_BYTES=65536

# 文件访问白名单(逗号分隔绝对路径前缀,空=全禁)
SANDBOX_FILE_ALLOWLIST=

# 网络白名单(逗号分隔 host:port,空=全禁)
SANDBOX_NET_ALLOWLIST=

# Python stdlib 允许导入的模块白名单(逗号分隔)
# 留空则使用内置默认安全集
SANDBOX_STDLIB_ALLOWLIST=

